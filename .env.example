APP_ENV=production
PORT=8080
SITE_URL=https://movies.example.com
DATABASE_PATH=/app/data/mwm.db
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=true

# Operator login. While ADMIN_PASSWORD is set it is re-applied on every boot, so
# the environment value is always the current admin password. Log in at /login
# (or /admin/login); the admin account can reach /admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploy

# Commerce and owned sponsor.
AMAZON_ASSOCIATE_TAG=
IMBH_BASE_URL=https://itsmadebyhand.com/

# Email is safely disabled until configured. "console" is available for local tests.
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=Movies We Missed <club@example.com>

# For EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Optional enrichment providers; disabled integrations do not block startup.
# METADATA_PROVIDER=tmdb enables TMDB matching (artwork, synopsis, credits, genres).
# METADATA_API_KEY is the TMDB API Read Access Token (v4).
# METADATA_WORKER=1 runs catalog enrichment in the background of the web process.
METADATA_PROVIDER=disabled
METADATA_API_KEY=
METADATA_WORKER=0
MODEL_PROVIDER=disabled
MODEL_API_KEY=
